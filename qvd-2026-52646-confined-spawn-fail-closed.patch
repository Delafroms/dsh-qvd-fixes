+/**
+ * Refuse a spawn that declares a restrictive sandbox policy without a
+ * confined argv. Sandbox constraints live in the argv wrapper the shell
+ * executors build through `ctx.sandbox.confine`; without this check a caller
+ * that resolves a `read-only`/`workspace-write` policy but forgets the
+ * confinement would launch an unconstrained child — the exact seam hole of
+ * QVD-2026-52646. The check sits at the execution point (the one place every
+ * spawn must cross), so a policy can never silently degrade to a bare spawn.
+ *
+ * Fail-closed on a policy whose `mode` is absent or unrecognized: only the
+ * literal `danger-full-access` is exempt. A policy object that reached this
+ * point without a usable mode is a caller bug, and treating it as
+ * "unrestricted" is exactly the degradation this guard exists to prevent.
+ * A spawn with no `sandboxPolicy` at all stays unchanged (host-owned).
+ * @param spec - the fully-specified spawn request.
+ * @throws when a policy is declared that is not `danger-full-access` and the argv is not marked confined.
+ */
+export function assertConfinedUnderPolicy(spec: SubprocessSpawnSpec): void {
+  if (spec.sandboxPolicy === undefined) return
+  const mode = spec.sandboxPolicy.mode
+  if (mode === 'danger-full-access') return
+  if (spec.argvConfined === true) return
+  throw new Error(
+    'subprocess: refusing an unconfined spawn under a restricted sandbox policy (mode "'
+    + String(mode) + '"); the argv must be confined by a sandbox backend before reaching the execution point',
+  )
+}
