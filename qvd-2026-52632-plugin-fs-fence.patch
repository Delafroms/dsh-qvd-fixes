+/**
+ * A dynamic plugin is code the model wrote at runtime, so its filesystem reads
+ * must carry the sandbox policy of the session owning the run — never a policy
+ * the plugin chose. The fs service itself stays pass-through for the host's own
+ * reads, so the fence belongs on the plugin-facing façade (QVD-2026-52632).
+ */
+describe('dynamic plugin filesystem fence — reads carry the owning session policy', () => {
+  const POLICY = { mode: 'read-only', workspaceRoot: '/ws' }
+
+  /** Mount a host half running `expr` against its injected fs, and report what the service received. */
+  async function readThrough(expr: string): Promise<unknown[][]> {
+    const harness = await setup()
+    const calls: unknown[][] = []
+    const session = { id: AGENT_A.id, header: { cwd: '/ws' } }
+    harness.ctx.provide('agents', {
+      get: (id: string) => (id === AGENT_A.id ? { ...AGENT_A, session } : undefined),
+    })
+    harness.ctx.provide('sandboxPolicy', { resolve: () => POLICY })
+    harness.ctx.provide('fs', {
+      readText: (...args: unknown[]) => { calls.push(args); return 'body' },
+      readBytes: (...args: unknown[]) => { calls.push(args); return new Uint8Array() },
+      stat: (...args: unknown[]) => { calls.push(args); return undefined },
+    })
+    await mount(harness, `
+      return {
+        name: 'reader',
+        inject: ['fs'],
+        async apply(ctx) { ${expr} },
+      }
+    `)
+    return calls
+  }
+
+  it('appends the session policy to a read that passed none', async () => {
+    const calls = await readThrough(`await ctx.fs.readText({ displayPath: '/etc/passwd' })`)
+    expect(calls).toHaveLength(1)
+    expect(calls[0]).toEqual([{ displayPath: '/etc/passwd' }, undefined, POLICY])
+  })
+
+  it('replaces a policy the plugin supplied, so it cannot widen its own boundary', async () => {
+    const calls = await readThrough(
+      `await ctx.fs.readText({ displayPath: '/etc/passwd' }, undefined, { mode: 'danger-full-access', workspaceRoot: '/' })`,
+    )
+    expect(calls[0]?.[2]).toEqual(POLICY)
+  })
+
+  it('keeps the policy last for a read whose optional arguments are all present', async () => {
+    const calls = await readThrough(
+      `await ctx.fs.readBytes({ displayPath: '/etc/passwd' }, undefined, 64)`,
+    )
+    expect(calls[0]).toEqual([{ displayPath: '/etc/passwd' }, undefined, 64, POLICY])
+  })
+
+  it('leaves a non-read member unfenced', async () => {
+    const calls = await readThrough(`await ctx.fs.stat({ displayPath: '/etc/passwd' })`)
+    expect(calls[0]).toEqual([{ displayPath: '/etc/passwd' }])
+  })
+})
