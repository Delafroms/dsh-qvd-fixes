+}
+
+/** The policy service this package reads; the deployment provides it. */
+interface SandboxPolicyLookup {
+  resolve(request: { session: Session }): FencedReadPolicy
+}
+
+/**
+ * Read methods whose content must carry the owning session's policy, mapped to
+ * the argument count each accepts before that policy (the fs service takes it
+ * last). A dynamic plugin reaching these without a policy would otherwise read
+ * host files outside its session's boundary (QVD-2026-52632).
+ */
+const FENCED_FS_READS: Readonly<Record<string, number>> = {
+  readText: 3,
+  streamText: 3,
+  readBytes: 4,
+}
+
+/**
+ * Filesystem façade for a dynamic plugin: content reads carry the policy
+ * resolved from the plugin's own session, substituted for whatever the caller
+ * passed, so a plugin cannot widen its own boundary. Every other member keeps
+ * the registration guard, so no call can return a Context.
+ * @param service - the live fs service the plugin declared.
+ * @param policy - the policy resolved from the owning session.
+ * @param reportFailure - reports a guard rejection to the owning Agent.
+ * @returns the fs service whose reads carry that policy.
+ */
+function fencedFsService(
+  service: object,
+  policy: FencedReadPolicy,
+  reportFailure: (error: Error) => void,
+): unknown {
+  const guarded = guardedService(service, 'fs', reportFailure) as object
+  return new Proxy(guarded, {
+    get(target, prop) {
+      const value = Reflect.get(target, prop) as unknown
+      if (typeof prop !== 'string' || typeof value !== 'function') return value
+      const arity = FENCED_FS_READS[prop]
+      if (arity === undefined) return value
+      return (...args: unknown[]): unknown => {
+        // Keep the declared position even when the caller omitted optional
+        // arguments, and drop anything it passed there: the policy is ours.
+        const forwarded = args.slice(0, arity - 1)
+        forwarded[arity - 1] = policy
+        return Reflect.apply(value as (...a: unknown[]) => unknown, target, forwarded)
+      }
+    },
+  })
+}
