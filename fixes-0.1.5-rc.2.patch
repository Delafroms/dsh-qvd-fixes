@@ -0,0 +1,224 @@
+/**
+ * Advisory per-agent repeat-TEXT detector. It watches the assistant text an
+ * agent commits across consecutive steps of one turn and, when the same text
+ * recurs, injects a logged model context asking it to stop repeating.
+ *
+ * Why this exists: `repeat-tool-reminder` observes `tools/post-execute`, so it
+ * can only see a loop that goes through tool calls. A model that emits the same
+ * plain text step after step — with no tool call at all — never reaches that
+ * guard, and the agent loop has no text-level loop detection of its own. The
+ * loop itself is not at fault: `agent.ts` ends the turn as soon as a step
+ * produces no tool call. This guard covers the case where the model keeps
+ * producing tool calls AND the same narration text, and the case where the same
+ * text rides along with an otherwise-progressing turn.
+ *
+ * Detection is structural, never a phrase blacklist: it compares the normalized
+ * text of consecutive assistant messages and counts a run. Any content change
+ * resets the run, so ordinary repetition of a word or a heading is not a loop.
+ *
+ * @module @deepseek-ai/dsh-repeat-text-reminder
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { MessageSource } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent, UserMessage } from '@deepseek-ai/dsh-session'
+
+export const name = 'repeat-text-reminder'
+
+/**
+ * Plugin config, validated by the same-named schemastery schema plus the
+ * load-time checks in `apply` (misconfiguration fails loud: an empty
+ * `thresholds` list, a non-integer, a value below 2, or a duplicate throws at
+ * plugin load, never a silent fall-back).
+ */
+export interface Config {
+  /** Consecutive identical-text counts that trigger a reminder (default `[3, 5, 8]`). */
+  thresholds?: number[]
+  /**
+   * Minimum normalized length a text must reach before it can be counted
+   * (default 8). Very short outputs ("ok", "好。") are extremely common as
+   * legitimate acknowledgements, so counting them would fire on ordinary work;
+   * the floor keeps the detector on substantive repetition. Set `0` to count
+   * every non-empty text.
+   */
+  minChars?: number
+  /**
+   * Maximum characters of the repeated text quoted in the DETAILED reminder
+   * (default 200). The cap bounds the reminder, never the detection.
+   */
+  textPreviewChars?: number
+}
+
+export const Config: z<Config> = z.object({
+  thresholds: z.array(z.number()).default([3, 5, 8]),
+  minChars: z.number().default(8),
+  textPreviewChars: z.number().default(200),
+})
+
+/**
+ * The `{kind:'plugin'}` source stamped on every reminder this guard injects —
+ * the label is load-bearing (an unlabeled context would render as a user prompt
+ * in derived history).
+ */
+const PLUGIN_SOURCE: MessageSource = { kind: 'plugin', plugin: 'repeat-text-reminder' }
+
+/** The gentle first-threshold reminder, keyed to `thresholds[0]`. */
+const GENTLE_REMINDER =
+  'You have emitted the same assistant text across consecutive steps. '
+  + 'Repeating narration does not make progress: either take the next concrete '
+  + 'action the task needs, or state plainly what is blocking you and stop.'
+
+/**
+ * The detailed later-threshold reminder naming the run length and quoting the
+ * repeated text.
+ * @param count - consecutive identical texts observed.
+ * @param preview - the (truncated) repeated text.
+ * @returns the reminder text.
+ */
+function detailedReminder(count: number, preview: string): string {
+  return `You have now emitted the same assistant text ${String(count)} times in a row. `
+    + 'The repeated text is not making progress. Stop repeating it: change approach, '
+    + 'ask for the missing input, or finish the turn.\n\nRepeated text:\n'
+    + preview
+}
+
+/**
+ * Validate `thresholds` per the fail-loud contract and return them sorted
+ * ascending (the escalation rule reads `thresholds[0]` as the gentle tier).
+ * @param values - configured thresholds.
+ * @returns the ascending, de-duplicated thresholds.
+ * @throws when the list is empty, holds a non-integer, or holds a value below 2.
+ */
+function validateThresholds(values: number[]): number[] {
+  if (values.length === 0) {
+    throw new Error('repeat-text-reminder: `thresholds` must not be empty')
+  }
+  for (const value of values) {
+    if (!Number.isInteger(value) || value < 2) {
+      throw new Error(`repeat-text-reminder: invalid threshold ${String(value)} — every threshold must be an integer >= 2`)
+    }
+  }
+  if (new Set(values).size !== values.length) {
+    throw new Error('repeat-text-reminder: `thresholds` must not contain duplicates')
+  }
+  return [...values].sort((left, right) => left - right)
+}
+
+/**
+ * Normalize one assistant text for comparison: collapse whitespace runs and
+ * trim. Only whitespace is folded — punctuation, wording, and case stay
+ * significant, so two genuinely different sentences never compare equal.
+ * @param text - the raw assistant text.
+ * @returns the comparison key.
+ */
+function normalize(text: string): string {
+  return text.replace(/\s+/gu, ' ').trim()
+}
+
+/**
+ * The joined text of one committed assistant message, or `undefined` when the
+ * message carried no text block at all (a pure tool-call step).
+ * @param event - a session event.
+ * @returns the joined assistant text, or undefined.
+ */
+function assistantTextOf(event: SessionEvent): string | undefined {
+  if (event.type !== 'assistant/message') return undefined
+  const message = (event.data as { message: { content: { type: string; text?: string }[] } }).message
+  const text = message.content
+    .filter(block => block.type === 'text')
+    .map(block => block.text ?? '')
+    .join('')
+  return text === '' ? undefined : text
+}
+
+/** One agent's consecutive-identical-text chain: the last key and its run length. */
+interface TextChain {
+  key: string
+  count: number
+}
+
+/**
+ * Register the repeat-text guard.
+ * @param ctx - owning plugin context; the listener is an effect on it.
+ * @param config - resolved plugin config (schema defaults applied).
+ */
+export function apply(ctx: Context, config?: Config): void {
+  const thresholds = validateThresholds(config?.thresholds as number[])
+  const thresholdSet = new Set(thresholds)
+  const minChars = config?.minChars ?? 8
+  const textPreviewChars = config?.textPreviewChars ?? 200
+  if (!Number.isInteger(minChars) || minChars < 0) {
+    throw new Error(`repeat-text-reminder: invalid minChars ${String(minChars)} — must be an integer >= 0`)
+  }
+  if (!Number.isInteger(textPreviewChars) || textPreviewChars < 1) {
+    throw new Error(`repeat-text-reminder: invalid textPreviewChars ${String(textPreviewChars)} — must be an integer >= 1`)
+  }
+
+  /** Per-agent chain state; keyed by the Agent object like the tool guard. */
+  const chains = new Map<Agent, TextChain>()
+
+  /**
+   * Read the newest committed assistant text of one agent, if any.
+   * @param agent - the agent whose session log is read.
+   * @returns the normalized key and raw text, or undefined.
+   */
+  function latestAssistantText(agent: Agent): { key: string; raw: string } | undefined {
+    const events = agent.session.snapshotEvents()
+    for (let index = events.length - 1; index >= 0; index -= 1) {
+      const event = events[index]
+      if (event === undefined) continue
+      const text = assistantTextOf(event)
+      if (text === undefined) continue
+      const key = normalize(text)
+      if (key.length < minChars) return undefined
+      return { key, raw: key }
+    }
+    return undefined
+  }
+  /**
+   * Advance the calling agent's chain for the text it just produced and return
+   * the reminder to deliver when the run length hits a configured threshold.
+   * @param agent - the agent whose step is starting.
+   * @returns the reminder message, or undefined.
+   */
+  function observe(agent: Agent): UserMessage | undefined {
+    const latest = latestAssistantText(agent)
+    if (latest === undefined) {
+      // No countable text yet (first step, or a short acknowledgement): the
+      // chain is not advanced, so a run only ever counts substantive repeats.
+      return undefined
+    }
+    const chain = chains.get(agent)
+    const count = chain !== undefined && chain.key === latest.key ? chain.count + 1 : 1
+    chains.set(agent, { key: latest.key, count })
+    if (!thresholdSet.has(count)) return undefined
+    const preview = latest.raw.length > textPreviewChars
+      ? `${latest.raw.slice(0, textPreviewChars)}…`
+      : latest.raw
+    const text = count === thresholds[0]
+      ? GENTLE_REMINDER
+      : detailedReminder(count, preview)
+    return createUserMessage({
+      content: [{ type: 'text', text }],
+      source: { ...PLUGIN_SOURCE, form: 'notice', summary: `repeated text × ${String(count)}` },
+    })
+  }
+
+  // Observe-and-enrich, never veto: the reminder rides onto whatever the
+  // downstream decision was, so a rejected step still carries the nudge. A
+  // genuine user interjection resets the chain — repetition across it is not a
+  // loop.
+  ctx.on('agent/pre-step', async ({ agent, messages }, next): Promise<PreStepDecision> => {
+    const downstream = await next()
+    if (messages.some(message => message.source.kind === 'user')) {
+      chains.delete(agent)
+      return downstream
+    }
+    const reminder = observe(agent)
+    if (reminder === undefined || downstream.kind === 'reject') return downstream
+    return { ...downstream, messages: [...downstream.messages, reminder] }
+  })
+}
