+    expect(result.content).toBeUndefined()
+  })
+
+  it.each([
+    ['dot-dot traversal', () => join(workspace, '..', 'out', 'canary.txt')],
+    ['repeated separators', () => `${workspace}${'/'.repeat(3)}..${'/'.repeat(3)}out${'/'.repeat(3)}canary.txt`],
+    ['trailing dot segment', () => join(workspace, '..', 'out', '.', 'canary.txt')],
+    ['mixed dot-dot and dot', () => join(workspace, '.', '..', '.', 'out', 'canary.txt')],
+    ['dot-dot beyond root then back', () => join(workspace, '..', 'out', '..', 'out', 'canary.txt')],
+    ['backslash-separated traversal', () => `${workspace}\\..\\out\\canary.txt`],
+  ])('refuses %s', async (_label, build) => {
+    const result = await attempt(build())
+    expect(result.denied).toBe(true)
+  })
