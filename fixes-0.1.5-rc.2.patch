+/**
+ * Adversarial suite for the read fence (QVD-2026-52632). Each case attempts to
+ * reach a canary OUTSIDE the workspace through a policy-carrying read; the
+ * canary is a real file in a sibling temp directory and nothing here touches
+ * anything outside the test tree.
+ *
+ * Link primitives are platform-gated by what an UNPRIVILEGED local attacker can
+ * actually create:
+ *   - POSIX: `symlink` freely.
+ *   - Windows: `symlink` needs elevation or Developer Mode, so an unprivileged
+ *     attacker uses a directory JUNCTION (no privilege) or a file HARDLINK
+ *     (no privilege). Both are exercised here.
+ *
+ * Cases the fence cannot refuse are recorded as CURRENT behavior with the
+ * reason, never asserted away.
+ */
+
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { link, mkdir, mkdtemp, rm, symlink, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
