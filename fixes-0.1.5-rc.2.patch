+    appendAssistant(a, 1, 'Agent A keeps saying exactly this same thing.')
+    await preStep(ctx, a, 2)
+    appendAssistant(a, 2, 'Agent A keeps saying exactly this same thing.')
+    expect(injectedTexts(await preStep(ctx, a, 3))).toHaveLength(1)
+    appendAssistant(b, 1, 'Agent B says something entirely different here.')
+    expect(injectedTexts(await preStep(ctx, b, 2))).toHaveLength(0)
