@@ -0,0 +1,244 @@
+/**
+ * Behavior + adversarial suite for the repeat-text guard.
+ *
+ * The guard enriches the `agent/pre-step` decision: it returns the reminder as
+ * an extra entry in `messages`, and the loop is what commits it. These tests
+ * therefore assert on the returned decision, which is the guard's actual
+ * contract.
+ *
+ * The adversarial cases prove it does NOT fire on ordinary work — that is the
+ * failure mode that matters for an advisory guard, because a false positive
+ * injects noise into every turn.
+ */
+
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId, type UserMessage } from '@deepseek-ai/dsh-session'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import * as RepeatTextGuard from '@deepseek-ai/dsh-repeat-text-reminder'
+import type { Config } from '@deepseek-ai/dsh-repeat-text-reminder'
+import { MockAdapter, textResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+
+/** Boot the core spine + the guard; the caller registers adapters. */
+async function harness(config: Config = {}): Promise<Context> {
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(RepeatTextGuard, config)
+  return ctx
+}
+
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => {
+    const dispose = ctx.on('agent/status', ({ agent: subject, status }) => {
+      if (subject === agent && status === 'idle') { dispose(); resolve() }
+    })
+  })
+}
+
+/** Commit one assistant text message the way the loop does (surface-eligible needs a marker). */
+function appendAssistant(agent: Agent, step: number, text: string): void {
+  agent.session.append('assistant/message', {
+    turn: 1,
+    step,
+    message: { role: 'assistant', content: [{ type: 'text', text }] },
+  } as never, { surfaceOp: 'append' })
+}
+
+/** Drive one pre-step boundary and return the decision the guard produced. */
+async function preStep(
+  ctx: Context,
+  agent: Agent,
+  step: number,
+  messages: UserMessage[] = [],
+): Promise<PreStepDecision> {
+  return await ctx.waterfall(
+    'agent/pre-step',
+    { agent, messages, turn: 1, step, signal: new AbortController().signal },
+    async (): Promise<PreStepDecision> => ({ kind: 'enter', messages: [] }),
+  ) as PreStepDecision
+}
+
+/** The injected texts a decision carries (empty when it rejected or added none). */
+function injectedTexts(decision: PreStepDecision): string[] {
+  if (decision.kind !== 'enter') return []
+  return decision.messages.map(message =>
+    message.content.map(block => block.type === 'text' ? block.text : '').join(''))
+}
+
+async function agentOf(ctx: Context, id: string): Promise<Agent> {
+  return await ctx.agentLoop.create(SessionId(id), { provider: 'mock', model: 'mock' })
+}
+
+describe('repeat-text guard — fires on a genuine text loop', () => {
+  it('reminds at the configured threshold', async () => {
+    const ctx = await harness({ thresholds: [2] })
+    const agent = await agentOf(ctx, 'direct')
+    appendAssistant(agent, 1, 'I will now examine the file.')
+    expect(injectedTexts(await preStep(ctx, agent, 2))).toHaveLength(0)
+    appendAssistant(agent, 2, 'I will now examine the file.')
+    const texts = injectedTexts(await preStep(ctx, agent, 3))
+    expect(texts).toHaveLength(1)
+    expect(texts[0]).toContain('same assistant text')
+  })
+
+  it('escalates to the detailed reminder at the later threshold', async () => {
+    const ctx = await harness({ thresholds: [2, 3] })
+    const agent = await agentOf(ctx, 'escalate')
+    const body = 'The same long narration text repeated verbatim.'
+    const seen: string[] = []
+    for (let step = 1; step <= 3; step += 1) {
+      appendAssistant(agent, step, body)
+      seen.push(...injectedTexts(await preStep(ctx, agent, step + 1)))
+    }
+    expect(seen.some(t => t.includes('same assistant text'))).toBe(true)
+    expect(seen.some(t => t.includes('3 times in a row'))).toBe(true)
+  })
+
+  it('stamps the notice source so derived history does not read it as a user prompt', async () => {
+    const ctx = await harness({ thresholds: [2] })
+    const agent = await agentOf(ctx, 'source')
+    appendAssistant(agent, 1, 'Repeated body text that is long enough to count.')
+    await preStep(ctx, agent, 2)
+    appendAssistant(agent, 2, 'Repeated body text that is long enough to count.')
+    const decision = await preStep(ctx, agent, 3)
+    expect(decision.kind).toBe('enter')
+    if (decision.kind !== 'enter') return
+    expect(decision.messages[0]!.source).toMatchObject({
+      kind: 'plugin', plugin: 'repeat-text-reminder', form: 'notice',
+    })
+  })
+
+  it('treats whitespace-only differences as the same text', async () => {
+    const ctx = await harness({ thresholds: [2] })
+    const agent = await agentOf(ctx, 'ws')
+    appendAssistant(agent, 1, 'Examining   the   file now.')
+    await preStep(ctx, agent, 2)
+    appendAssistant(agent, 2, 'Examining the file now.')
+    expect(injectedTexts(await preStep(ctx, agent, 3))).toHaveLength(1)
+  })
+})
+
+describe('repeat-text guard — adversarial: must NOT fire on ordinary work', () => {
+  it('does not fire on a single plain-text answer', async () => {
+    const ctx = await harness()
+    const agent = await agentOf(ctx, 'single')
+    appendAssistant(agent, 1, 'Here is the answer you asked for.')
+    expect(injectedTexts(await preStep(ctx, agent, 2))).toHaveLength(0)
+  })
+
+  it('does not fire on short acknowledgements even when repeated five times', async () => {
+    // 'ok' / '好。' are legitimate one-word replies; counting them would make
+    // the guard fire on ordinary conversation.
+    for (const short of ['ok', '好。', 'done', 'yes']) {
+      const ctx = await harness({ thresholds: [2], minChars: 8 })
+      const agent = await agentOf(ctx, `short-${short}`)
+      const seen: string[] = []
+      for (let step = 1; step <= 5; step += 1) {
+        appendAssistant(agent, step, short)
